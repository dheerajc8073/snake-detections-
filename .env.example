# =========================================================
# 🐍 ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file with real secrets
# =========================================================

# TELEGRAM CONFIGURATION
# Get your BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Chat ID (get it from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# EMERGENCY DETAILS
EMERGENCY_CONTACT=your_emergency_number
LOCATION=Your Location Name

# YOLO MODEL SETTINGS
# Confidence threshold (0.0 to 1.0)
CONF_THRESHOLD=0.80

# Alert cooldown in seconds (prevents spam alerts)
ALERT_COOLDOWN=120

# CAMERA SETTINGS
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_INDEX=0

# MODEL PATH
MODEL_PATH=./snake_model.pt

# OUTPUT SETTINGS
DETECTIONS_FOLDER=detections
SAVE_DETECTIONS=true

# ALERTS
ENABLE_VOICE_ALERT=true
ENABLE_SOUND_ALERT=true
ENABLE_TELEGRAM_ALERT=true
ENABLE_TELEGRAM_PHOTO=true

# VOICE SETTINGS
VOICE_SPEED=150
VOICE_VOLUME=1.0

# DEBUG MODE
DEBUG=false
VERBOSE=false
